    "info_active_lsp_offline" : {
      "comment" : "Footer note in Settings > Lightning Service Provider shown when the device is offline.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بالإنترنت للتحقق من اتصالك بمزود خدمة Lightning هذا."
