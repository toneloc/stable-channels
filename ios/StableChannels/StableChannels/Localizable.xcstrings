    "backup_warning_body" : {
      "comment" : "Warning text on the export-backup screen: backup has the seed phrase but not Lightning channel state. Includes support email.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي هذه النسخة الاحتياطية على عبارة الاسترداد الخاصة بك. حالة قناة Lightning غير متضمنة. يرجى مراسلة support@stablechannels.com عبر البريد الإلكتروني للاستفسار أو للمساعدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ব্যাকআপে আপনার সিড ফ্রেজ রয়েছে। Lightning চ্যানেলের অবস্থা অন্তর্ভুক্ত নয়। প্রশ্ন বা সহায়তার জন্য অনুগ্রহ করে support@stablechannels.com-এ ইমেইল করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup enthält deine Seed-Phrase. Der Lightning-Kanalstatus ist NICHT enthalten. Bei Fragen oder für Hilfe schreibe an support@stablechannels.com."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
