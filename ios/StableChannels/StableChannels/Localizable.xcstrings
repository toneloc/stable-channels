    "lsp_locked_body" : {
      "comment" : "Body text in LSP settings explaining that the active channel must be closed to switch provider.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق قناتك النشطة لتغيير LSP."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LSP পরিবর্তন করতে আপনার সক্রিয় চ্যানেল বন্ধ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe deinen aktiven Kanal, um den LSP zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Close your active channel to switch LSP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra tu canal activo para cambiar de LSP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermez votre canal actif pour changer de LSP."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LSP बदलने के लिए अपना सक्रिय चैनल बंद करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LSPを切り替えるには、アクティブなチャネルを閉じてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche seu canal ativo para trocar de LSP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте активный канал, чтобы сменить LSP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先关闭当前活跃的通道,再切换 LSP。"
          }
        }
      }
    },
    "lsp_locked_footer" : {
      "comment" : "Footer in LSP settings explaining why the provider cannot change while a channel is open.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تغيير مزود خدمة Lightning أثناء وجود قناة مفتوحة. العقدة المقابلة جزء من معاملة تمويل القناة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চ্যানেল খোলা থাকাকালীন Lightning সার্ভিস প্রোভাইডার পরিবর্তন করা যায় না। কাউন্টারপার্টি নোড চ্যানেলের ফান্ডিং ট্রানজ্যাকশনের অংশ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lightning Service Provider kann nicht geändert werden, solange ein Kanal geöffnet ist. Der Gegenknoten ist Teil der Funding-Transaktion des Kanals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Lightning Service Provider cannot be changed while a channel is open. The counterparty node is part of the channel's funding transaction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor de servicios Lightning no se puede cambiar mientras haya un canal abierto. El nodo contraparte forma parte de la transacción de financiación del canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur de services Lightning ne peut pas être modifié tant qu'un canal est ouvert. Le nœud homologue fait partie de la transaction de financement du canal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल खुला होने पर Lightning सर्विस प्रोवाइडर बदला नहीं जा सकता। काउंटरपार्टी नोड चैनल के फंडिंग लेन-देन का हिस्सा है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャネルが開いている間は、Lightning Service Providerを変更できません。相手のノードはチャネルの資金調達トランザクションの一部であるためです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor de serviços Lightning não pode ser alterado enquanto houver um canal aberto. O nó da contraparte faz parte da transação de financiamento do canal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдера услуг Lightning нельзя изменить, пока канал открыт. Узел контрагента входит в фондирующую транзакцию канала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通道开启期间无法更改 Lightning Service Provider。对手节点是通道注资转账的一部分。"
          }
        }
      }
    },
    "lsp_locked_footer_offline" : {
      "comment" : "Footer in LSP settings when offline; configuration stays locked while a channel is open.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بالإنترنت للتحقق من اتصالك بمزود خدمة Lightning. تظل الإعدادات مقفلة أثناء وجود قناة مفتوحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Lightning সার্ভিস প্রোভাইডার সংযোগ যাচাই করতে ইন্টারনেটে সংযুক্ত হন। চ্যানেল খোলা থাকাকালীন কনফিগারেশন লক থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich mit dem Internet, um die Verbindung zu deinem Lightning Service Provider zu prüfen. Die Konfiguration bleibt gesperrt, solange ein Kanal geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connect to the internet to verify your Lightning Service Provider connection. Configuration remains locked while a channel is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a internet para verificar la conexión con tu proveedor de servicios Lightning. La configuración permanece bloqueada mientras haya un canal abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à Internet pour vérifier votre connexion au fournisseur de services Lightning. La configuration reste verrouillée tant qu'un canal est ouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना Lightning सर्विस प्रोवाइडर कनेक्शन जाँचने के लिए इंटरनेट से कनेक्ट करें। चैनल खुला होने तक कॉन्फ़िगरेशन लॉक रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightning Service Providerとの接続を確認するには、インターネットに接続してください。チャネルが開いている間、設定はロックされたままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte-se à internet para verificar a conexão com seu provedor de serviços Lightning. A configuração permanece bloqueada enquanto houver um canal aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключитесь к интернету, чтобы проверить связь с вашим провайдером услуг Lightning. Конфигурация остаётся заблокированной, пока канал открыт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请连接互联网以验证与 Lightning Service Provider 的连接。通道开启期间,配置保持锁定。"
          }
        }
      }
    },
