    "error_offline_send" : {
      "comment" : "Error banner on Send when the device is offline and the payment cannot be sent.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل بالإنترنت. لا يمكن إرسال المدفوعات حتى تعود الشبكة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অফলাইনে আছেন। নেটওয়ার্ক সংযোগ ফিরে না আসা পর্যন্ত পেমেন্ট পাঠানো যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Zahlungen können erst gesendet werden, wenn die Netzwerkverbindung wiederhergestellt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You’re offline. Payments cannot be sent until network connectivity is restored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión. Los pagos no se pueden enviar hasta que se restablezca la conexión de red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Les paiements ne peuvent pas être envoyés tant que la connexion n'est pas rétablie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऑफ़लाइन हैं। नेटवर्क कनेक्शन बहाल होने तक भुगतान नहीं भेजे जा सकते।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。ネットワークに接続するまで支払いを送信できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. Não é possível enviar pagamentos até que a conexão seja restabelecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не в сети. Платежи нельзя отправить, пока не восстановится подключение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您当前处于离线状态。网络恢复前无法发送付款。"
          }
        }
      }
    },
    "error_offline_trade" : {
      "comment" : "Error when the device is offline and a stability change (Stabilize/Unstabilize) cannot run.",
