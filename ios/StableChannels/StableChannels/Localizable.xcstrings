    "alert_connect_lsp_message" : {
      "comment" : "Message body of the Connect to LSP alert. LSP = Lightning Service Provider. Node restarts; no funds lost.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إعادة تشغيل عقدتك للاتصال بـ LSP الجديد. لن تفقد أي أموال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি নতুন LSP-এর সাথে সংযোগ করতে আপনার নোড রিস্টার্ট করবে। কোনো ফান্ড হারাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Node wird neu gestartet, um sich mit dem neuen LSP zu verbinden. Es gehen keine Gelder verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will restart your node to connect to the new LSP. No funds will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reiniciará tu nodo para conectarlo al nuevo LSP. No se perderán fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nœud va redémarrer pour se connecter au nouveau LSP. Aucun fonds ne sera perdu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए LSP से जुड़ने के लिए आपका नोड रीस्टार्ट होगा। कोई फंड नहीं खोएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいLSPに接続するため、ノードを再起動します。資金が失われることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso reiniciará seu nó para conectar ao novo LSP. Nenhum fundo será perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узел будет перезапущен для подключения к новому LSP. Средства не будут потеряны."
          }
