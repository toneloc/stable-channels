    "Please withdraw all BTC before proceeding. Existing wallet data will be completely overwritten." : {
      "comment" : "Warning text on the restore screen: the existing wallet will be replaced, so user should move funds out first.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى سحب كل الـ BTC قبل المتابعة. سيتم استبدال بيانات المحفظة الحالية تمامًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যাওয়ার আগে দয়া করে সমস্ত BTC প্রত্যাহার করুন। বিদ্যমান ওয়ালেট ডেটা সম্পূর্ণভাবে ওভাররাইট করা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte heben Sie alle BTC ab. Bestehende Daten werden überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retira todos los BTC. Los datos de la billetera serán sobrescritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez retirer tous les BTC avant de continuer. Les données du portefeuille existant seront écrasées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कृपया आगे बढ़ने से पहले सभी BTC निकाल लें। मौजूदा डेटा अधिलेखित हो जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行する前にすべてのBTCを引き出してください。既存のウォレットデータは完全に上書きされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, retire todos os BTC antes de continuar. Os dados existentes da carteira serão sobrescritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, выведите все BTC перед продолжением. Существующие данные кошелька будут перезаписаны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
