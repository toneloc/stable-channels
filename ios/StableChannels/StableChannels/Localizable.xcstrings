        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই Lightning সার্ভিস প্রোভাইডারের সাথে আপনার সংযোগ যাচাই করতে ইন্টারনেটে সংযুক্ত হন।"
          }
        },
        "de" : {
          "stringUnit" : {
