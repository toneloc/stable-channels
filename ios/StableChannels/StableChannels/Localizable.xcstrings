    "info_backup_seed" : {
      "comment" : "Footer under the seed phrase list in Settings. Security warning; keep the tone serious.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب هذه الكلمات وقم بتخزينها بأمان. يمكن لأي شخص يمتلك هذه الكلمات الوصول إلى أموالك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই শব্দগুলো লিখে রাখুন এবং নিরাপদে সংরক্ষণ করুন। এই শব্দগুলো যার কাছে আছে সে আপনার তহবিল অ্যাক্সেস করতে পারবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreiben Sie diese Wörter auf und verwahren Sie sie sicher. Jeder mit diesen Wörtern hat Zugriff auf Ihr Geld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Write these words down and store them safely. Anyone with these words can access your funds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe estas palabras y guárdalas con seguridad. Quien las tenga podrá acceder a tus fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez ces mots et conservez-les en sécurité. Quiconque possède ces mots peut accéder à vos fonds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन शब्दों को लिख लें। जिसके पास ये शब्द होंगे, वह आपके फंड तक पहुंच सकता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの単語を書き留めて、安全に保管してください。これらの単語を持つ者は誰でもあなたの資金にアクセスできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote estas palavras e guarde-as com segurança. Qualquer pessoa com estas palavras poderá acessar seus fundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите эти слова и храните их в надежном месте. Любой, у кого есть эти слова, может получить доступ к вашим средствам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写下这些单词并妥善保管。任何人拥有这些单词都可以访问您的资金。"
          }
        }
      }
    },
    "info_channel_offline_note" : {
      "comment" : "Footer note in Channel settings when offline; values shown are cached, not live.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقاييس القناة محفوظة مؤقتًا. أعد الاتصال بالإنترنت لمزامنة الرصيد مباشرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চ্যানেলের মেট্রিক্স ক্যাশ করা আছে। লাইভ ব্যালেন্স সিঙ্ক্রোনাইজেশনের জন্য ইন্টারনেটে পুনরায় সংযুক্ত হন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanalwerte zwischengespeichert. Verbinde dich wieder mit dem Internet für die Live-Synchronisierung des Guthabens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Channel metrics cached. Reconnect to the internet for live balance synchronization."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Métricas del canal en caché. Vuelve a conectarte a internet para sincronizar el saldo en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesures du canal en cache. Reconnectez-vous à Internet pour la synchronisation du solde en direct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल मेट्रिक्स कैश किए गए हैं। लाइव बैलेंस सिंक के लिए इंटरनेट से दोबारा कनेक्ट करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
