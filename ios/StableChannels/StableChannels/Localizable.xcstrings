          "stringUnit" : {
            "state" : "translated",
            "value" : "लेन-देन प्रसारित हो गया। ऑन-चेन पुष्टि होने पर यह अंतिम हो जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランザクションをブロードキャストしました。オンチェーンで承認されると確定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
