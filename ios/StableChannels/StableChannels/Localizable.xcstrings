    "note_bolt12_asynchronous" : {
      "comment" : "Status note after sending to a Lightning offer; the node is requesting an invoice from the recipient.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال طلب الدفع للعرض. تطلب عقدتك فاتورة عبر رسائل Lightning المشفرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অফার পেমেন্ট পাঠানো হয়েছে। আপনার নোড Lightning অনিয়ন মেসেজিংয়ের মাধ্যমে একটি ইনভয়েস অনুরোধ করছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offer-Zahlung abgesendet. Dein Node fordert über Lightning-Onion-Messaging eine Rechnung an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Offer payment dispatched. Your node is requesting an invoice over Lightning onion messaging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pago de oferta enviado. Tu nodo está solicitando una factura mediante mensajería onion de Lightning."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offre envoyée. Votre nœud demande une facture via la messagerie onion Lightning."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़र भुगतान भेज दिया गया। आपका नोड Lightning ओनियन मैसेजिंग के ज़रिए इनवॉइस माँग रहा है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オファーの支払いを送信しました。ノードがLightningのオニオンメッセージでインボイスをリクエストしています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagamento da oferta enviado. Seu nó está solicitando uma fatura via mensagens onion do Lightning."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платёж по предложению отправлен. Ваш узел запрашивает счёт через onion-сообщения Lightning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offer 付款已发出。您的节点正在通过 Lightning 洋葱消息请求发票。"
          }
        }
      }
    },
    "note_onchain_awaiting_confirmation" : {
      "comment" : "Status note after an onchain payment was broadcast; it is final after confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
