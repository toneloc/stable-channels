    "offline_body" : {
      "comment" : "Body text on the offline screen. Reassures the user that keys stay on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الاتصال بالخادم دون اتصال بالإنترنت. محفظتك ومفاتيحك آمنة على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট সংযোগ ছাড়া সার্ভারে সংযোগ করা যায় না। আপনার ওয়ালেট ও কী এই ডিভাইসে নিরাপদ থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Internetverbindung kann keine Verbindung zum Server hergestellt werden. Deine Wallet und Schlüssel bleiben sicher auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cannot connect to the server without an internet connection. Your wallet and keys remain safe on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con el servidor sin conexión a internet. Tu billetera y tus claves siguen seguras en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se connecter au serveur sans connexion Internet. Votre portefeuille et vos clés restent en sécurité sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट कनेक्शन के बिना सर्वर से कनेक्ट नहीं हो सकता। आपका वॉलेट और कीज़ इस डिवाइस पर सुरक्षित रहती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットに接続していないため、サーバーに接続できません。ウォレットとキーはこのデバイス上で安全に保管されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível conectar ao servidor sem conexão com a internet. Sua carteira e suas chaves permanecem seguras neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся подключиться к серверу без интернета. Ваш кошелёк и ключи остаются в безопасности на этом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有互联网连接,无法连接服务器。您的钱包和密钥仍安全保存在此设备上。"
          }
        }
      }
    },
