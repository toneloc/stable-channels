    "note_payment_pending" : {
      "comment" : "Status note after sending: settlement continues in the background; user can check the History tab.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال الدفعة. التسوية قيد الانتظار في الخلفية. تحقق من السجل لمعرفة الحالة النهائية."
