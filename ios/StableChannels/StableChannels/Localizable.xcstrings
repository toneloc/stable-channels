    "Face ID access is turned off for Stable Channels. Please enable it in Settings > Stable Channels > Face ID." : {
      "comment" : "Alert message when Face ID permission is denied. Keep the Settings menu path matching iOS wording in your language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
