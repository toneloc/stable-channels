    "alert_reset_lsp_message" : {
      "comment" : "Message body of the Reset LSP alert. LSP = Lightning Service Provider; restores the default one and restarts the node.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إعادة الاتصال بـ LSP الافتراضي لـ Stable Channels وإعادة تشغيل عقدتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি ডিফল্ট Stable Channels LSP-এর সাথে পুনরায় সংযোগ করবে এবং আপনার নোড রিস্টার্ট করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
