        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ওয়ালেট সুরক্ষিত রাখতে ও লেনদেন নিশ্চিত করতে Stable Channels Face ID ব্যবহার করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
