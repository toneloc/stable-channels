    "NSFaceIDUsageDescription" : {
      "comment" : "Permission prompt shown by iOS before the app first uses Face ID.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Stable Channels بصمة الوجه Face ID لتأمين محفظتك وتأكيد المعاملات."
