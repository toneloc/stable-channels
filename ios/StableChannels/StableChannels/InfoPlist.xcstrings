    "NSCameraUsageDescription" : {
      "comment" : "Permission prompt shown by iOS before the app opens the camera.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الكاميرا لمسح رموز QR لفواتير Lightning وعناوين البيتكوين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightning ইনভয়েস ও বিটকয়েন ঠিকানার QR কোড স্ক্যান করতে ক্যামেরা ব্যবহার করা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird zum Scannen von QR-Codes für Lightning-Rechnungen und Bitcoin-Adressen verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera is used to scan QR codes for Lightning invoices and Bitcoin addresses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se usa para escanear códigos QR de facturas Lightning y direcciones de bitcoin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appareil photo sert à scanner les codes QR des factures Lightning et des adresses bitcoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightning इनवॉइस और बिटकॉइन पतों के QR कोड स्कैन करने के लिए कैमरे का उपयोग होता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LightningインボイスやビットコインアドレスのQRコードを読み取るためにカメラを使用します。"
