# Serves the lsp-server-gui wasm bundle, reverse-proxies the SC daemon REST,
# and serves the GUI admin token at /setup/token.txt (written by 40-provision-gui-token.sh).
# /setup is restricted to Umbrel's app_proxy by /etc/nginx/setup-key-allow.conf.
# The locations live in gui-locations.inc (shared with the optional TLS server from 30-gui-tls.sh).
# ${SC_LSP_UPSTREAM} is substituted at container start by the stock nginx
# envsubst entrypoint (only defined env vars are substituted; $uri survives).
server {
    listen 80;

    include /etc/nginx/conf.d/gui-locations.inc;
}
